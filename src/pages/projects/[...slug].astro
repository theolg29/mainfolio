---
// Basics
import MainLayout from "@/layouts/MainLayout.astro";

// Assets
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { ArrowUpRight, Undo2 } from "lucide-react";

// Components
import Button from "@/components/Button.astro";
import ImageModal from "@/components/ImageModal.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const toc = headings.filter((heading) => heading.depth === 2);
---

<MainLayout
  title={`${project.data.title} - Théo Le gourrierec`}
  description={project.data.description}
>
  <section class="container">
    <section class="content-project">
      <aside class="project-toc">
        <a href="/projects" class="toc-back flex items-center gap-2">
          <Undo2 size={16} strokeWidth={1.5} />
          Retour aux projets
        </a>
        {
          toc.length > 0 && (
            <nav id="project-toc-nav">
              {toc.map((heading) => (
                <a href={`#${heading.slug}`} data-toc-slug={heading.slug}>
                  {heading.text}
                </a>
              ))}
            </nav>
          )
        }
      </aside>
      <article>
        {
          project.data.heroImage && (
            <Image
              class="featured"
              src={project.data.heroImage}
              alt={project.data.title}
            />
          )
        }
        <h1 class="mt-2">{project.data.title}</h1>
        {
          project.data.pubDate && (
            <p class="date mb-3">{project.data.pubDate}</p>
          )
        }
        <div class="tags">
          {project.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>

        <section class="markdown flex flex-col mt-12">
          <Content />
        </section>
        {
          project.data.video && (
            <iframe
              width="100%"
              height="500"
              src={project.data.video}
              title="YouTube video player"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          )
        }
        <div class="flex flex-col items-start gap-5 mt-12">
          {
            project.data.url && (
              <Button
                id="project"
                target="_blank"
                theme="black-button"
                link={project.data.url}
                text={`Découvrir ${project.data.title}`}
                icon={ArrowUpRight}
              />
            )
          }
          <!-- {
            project.data.archive && (
            <Button id="archive" target="_blank" theme="black-button" link={project.data.archive} text={`Découvrir le site ${project.data.title} avant`} icon={extIcon.src} />
            )
          } -->
        </div>
      </article>
    </section>
  </section>

  <!-- Modal pour l'agrandissement des images -->
  <ImageModal />
</MainLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>(
      "#project-toc-nav a"
    );
    if (!tocLinks.length) return;

    const sections = Array.from(tocLinks)
      .map((link) => {
        const slug = link.dataset.tocSlug;
        return slug ? document.getElementById(slug) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    function setActive(slug: string) {
      tocLinks.forEach((link) => {
        link.classList.toggle("active", link.dataset.tocSlug === slug);
      });
    }

    if (sections[0]) setActive(sections[0].id);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        });
      },
      { rootMargin: "-100px 0px -70% 0px" }
    );

    sections.forEach((section) => observer.observe(section));
  });
</script>
