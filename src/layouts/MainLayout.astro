---
import "../styles/styles.scss";
const { title, description } = Astro.props;
import Navigation from "@/components/Navigation.astro";
import Footer from "@/components/Footer.astro";
import { AnimatedThemeToggler } from "@/components/ui/animated-theme-toggler";

// Icons
import { Mail, ArrowUp } from "lucide-react";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://www.theolegourrierec.fr" />
    <link rel="preconnect" href="https://umami.theolegourrierec.fr" />
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />

    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var prefersDark =
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <script>
      window.addEventListener("load", function () {
        setTimeout(function () {
          var script = document.createElement("script");
          script.defer = true;
          script.src = "https://umami.theolegourrierec.fr/script.js";
          script.setAttribute(
            "data-website-id",
            "80d1ac04-b763-4ca7-84b4-2324ef2da70f"
          );
          document.head.appendChild(script);
        }, 1500);
      });
    </script>
  </head>
</html>
<body>
  <Navigation />
  <div class="visitor-pill">
    <span class="visitor-pill-dot"></span>
    <span class="visitor-pill-count">1 visiteur</span>
  </div>
  <AnimatedThemeToggler client:load className="theme-toggler" />
  <slot />
  <Footer />
  <div
    class="bottom-action flex flex-col md:flex-row gap-5 items-center justify-center"
  >
    <button
      class="black-button to-contact"
      onclick="window.location.href = '/contact'"
      aria-label="Contact"
    >
      <Mail className="icon" strokeWidth={1.5} />
    </button>
    <button
      class="black-button to-top"
      onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
      aria-label="Retour en haut"
    >
      <ArrowUp className="icon" strokeWidth={1.5} />
    </button>
  </div>
</body>
<script src="@/components/scripts/scrollSmooth.js"></script>
<script>
  import { initTextSlideHover } from "@/components/scripts/textSlideHover.js";
  document.addEventListener("DOMContentLoaded", initTextSlideHover);
</script>
<script>
  import { initMultiplayerCursors } from "@/components/scripts/multiplayerCursors.js";
  document.addEventListener("DOMContentLoaded", initMultiplayerCursors);
</script>
