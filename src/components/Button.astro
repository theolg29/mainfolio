---
const { id, theme, link, text, icon: Icon, target = "_self" } = Astro.props;
---

<button class="h-fit">
  <a id={id} class={`flex gap-2 justify-center items-center ${theme}`} href={link} target={target}>
    {Icon && <Icon className="icon" size={16} strokeWidth={1.5} />}
    {text}
  </a>
</button>