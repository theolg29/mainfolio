---
// Assets
import { Image } from "astro:assets";
import Button from "../Button.astro";
import ProfilePicture from "@/assets/images/profile-picture.png";
import downloadIcon from "@/assets/icons/dl-icon.svg";
import BentoLogo from "@/assets/logo/bentome.png";
import LottieAnimation from "astro-integration-lottie/Lottie.astro";
import DraggableCard from "../DraggableCard";
---

<div class="head">
  <h2>À propos de moi</h2>
  <p>Pour en savoir un peu plus qui je suis 👀</p>
</div>

<div class="flex flex-col align-center gap-12 w-full md:w-8/12">
  <div class="flex justify-between">
    <DraggableCard className="picture-card" initialRotation={-3} client:visible>
      <Image
        src={ProfilePicture}
        alt="Photo de Théo Legourrierec"
        loading="lazy"
        format="webp"
        quality={80}
        width={200}
        height={200}
      />
      <p class="text-center mt-4">Une photo de moi</p>
    </DraggableCard>
    <DraggableCard className="map-card" initialRotation={3} client:visible>
      <LottieAnimation src="/lotties/map.json" autoplay="visible" />
      <p class="text-center mt-4">Je suis ici</p>
    </DraggableCard>
  </div>

  <div class="flex flex-col gap-5 items-start">
    <p>
      Salut, moi c'est Théo, j’ai 21 ans.<br /><br />
      Je suis actuellement en première année de Master Création Numérique parcours
      Design d'Expérience et Design d'Interface (DEDI). J'ai eu l'opportunité d'intégrer
      l'agence Teaps en tant qu'alternant en Design UI / UX.<br /><br />
      Aujourd'hui, mon objectif est de devenir Designer UI/UX & Intégrateur Web afin
      de créer des sites internet attrayants et performants.
    </p>

    <div class="flex flex-col md:flex-row gap-5">
      <Button
        theme="black-button"
        target="_blank"
        link="/CV_THEOLEGOURRIEREC.pdf"
        text="Télécharger mon CV"
        icon={downloadIcon.src}
      />
    </div>
  </div>
</div>
