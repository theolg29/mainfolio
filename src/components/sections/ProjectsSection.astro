---
// Assets
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
const projects = await getCollection("projects");
const pinnedProjects = projects.filter((project) => project.data.pin);
---

<script>
  import { initProjectsShowcase } from "../scripts/projectsShowcase.js";
  document.addEventListener("DOMContentLoaded", initProjectsShowcase);
</script>

<div class="projects-showcase">
  <div class="showcase-grid">
    <div class="showcase-list-wrap">
      <div class="head">
        <h2>Mes projets pépites</h2>
      </div>

      <ul class="showcase-list">
        {
          pinnedProjects.map((project) => (
            <li class="showcase-item" data-project={project.id}>
              <button type="button" class="showcase-item-title">
                <h3>{project.data.title}</h3>
              </button>
              <div class="showcase-item-body">
                <div class="showcase-item-body-inner">
                  <p>{project.data.description}</p>
                  <a
                    href={`/projects/${project.id}`}
                    class="showcase-item-link inline-flex items-center gap-1"
                  >
                    Voir le projet
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="showcase-all">
        <a href="/projects" class="showcase-item-all-link">
          <span>Voir tous les projets</span>
        </a>
      </div>
    </div>

    <div class="showcase-media">
      {
        pinnedProjects.map((project) => (
          <a
            href={`/projects/${project.id}`}
            class="showcase-media-item"
            data-project={project.id}
          >
            <div class="showcase-image-frame">
              <Image
                class="showcase-image"
                src={project.data.heroImage}
                alt={project.data.title}
              />
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>
