---
// Components
import Button from "@/components/Button.astro";
import { DotPattern } from "@/components/ui/dot-pattern";
import { BeforeAfterGallery } from "@/components/ui/before-after-gallery";

// Data
// Pas encore de vraies images avant/après disponibles : on place des photos
// placeholder (Lorem Picsum) au format portrait sur plusieurs projets en
// attendant — à remplacer plus tard par les vraies captures.
const beforeAfterItems = [
  "Mer & Projets",
  "Kership",
  "Pinfig",
  "Bleep",
  "Onfido",
  "Solame",
].map((title) => {
  const seed = title.toLowerCase().replace(/[^a-z0-9]+/g, "-");
  return {
    title,
    before: `https://picsum.photos/seed/${seed}-before/600/800`,
    after: `https://picsum.photos/seed/${seed}-after/600/800`,
  };
});
---

<div class="hero-text-col flex flex-col items-center w-full">
  <h1 class="fade-up slide-reveal" style="animation-delay: 0.1s;">
    <span class="slide-reveal-inner inline-block"
      >Votre prochain designer UI/UX.</span
    >
  </h1>

  <p class="mt-2 fade-up slide-reveal" style="animation-delay: 1.2s;">
    <span class="slide-reveal-inner inline-block"
      >Je conçois et intègre des interfaces claires, rapides et pensées pour
      l'utilisateur.</span
    >
  </p>

  <div class="mt-6 fade-up slide-reveal" style="animation-delay: 2.3s;">
    <div
      class="slide-reveal-inner flex items-center justify-center flex-col md:flex-row gap-5"
    >
      <Button theme="black-button" link="/contact" text="Contactez-moi" />
      <Button theme="white-button" link="#about" text="Découvrir mon portfolio" />
    </div>
  </div>
</div>

<div class="hero-media fade-up" style="animation-delay: 2.6s;">
  <div class="showcase-image-frame hero-ba-frame">
    <DotPattern client:load className="hero-dot-pattern" />
    <BeforeAfterGallery client:load items={beforeAfterItems} />
  </div>
</div>
